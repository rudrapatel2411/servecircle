// server/prisma/schema.prisma
// ServeCircle Core Relational Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
  B2B
}

enum WorkerStatus {
  PENDING_INTERVIEW
  INTERVIEW_DONE
  APPROVED_ROOKIE
  APPROVED_JUNIOR
  APPROVED_SENIOR
  REJECTED
}

enum DutyStatus {
  ONLINE
  OFFLINE
  PAUSED
}

enum ProofType {
  BEFORE_WORK
  AFTER_WORK
}

enum RevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutType {
  BANK_ACCOUNT
  UPI
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum SosSeverity {
  HIGH
  CRITICAL
}

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionPlan {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ContractType {
  MONTHLY_CLEANING
  QUARTERLY_MAINTENANCE
  WEEKLY_SERVICES
  ANNUAL_PACKAGE
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  RENEWAL_DUE
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  STARTED
  COMPLETED
  PAID
  CLOSED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum TransactionType {
  TOPUP
  PAYMENT
  REFUND
  EARNING
  WITHDRAWAL
  BONUS
  COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ComplaintCategory {
  SERVICE_QUALITY
  PAYMENT
  WORKER_BEHAVIOUR
  DELAY
  DAMAGE
  FRAUD
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================
model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  phone          String?
  password       String
  role           UserRole  @default(CUSTOMER)
  avatar         String?
  city           String?   @default("Mumbai")
  walletBalance  Float     @default(0.0)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 1-to-1 Worker Profile
  workerProfile  WorkerProfile?

  // Bookings relations
  customerBookings Booking[] @relation("CustomerBookings")
  workerBookings   Booking[] @relation("WorkerBookings")
  traineeBookings  Booking[] @relation("TraineeBookings")

  // Financial relations
  walletTransactions WalletTransaction[]

  // Reviews
  customerReviews Review[] @relation("CustomerReviews")
  workerReviews   Review[] @relation("WorkerReviews")

  // Complaints
  filedComplaints    Complaint[] @relation("FiledComplaints")
  assignedComplaints Complaint[] @relation("AgainstUserComplaints")
  resolvedComplaints Complaint[] @relation("ResolvedByAdminComplaints")

  // Subscriptions & B2B Contracts
  subscriptions Subscription[]
  contracts     Contract[]     @relation("PartnerContracts")
  invoices      Invoice[]      @relation("PartnerInvoices")

  // Coupons created
  createdCoupons Coupon[] @relation("AdminCoupons")

  // M2: In-app chat messages
  sentBookingMessages BookingMessage[] @relation("SentMessages")

  // M3: Proof submissions
  submittedProofs BookingProof[]

  // M5: Payout requests
  payoutRequests PayoutRequest[]

  // M6: SOS incidents & 2-way reviews
  sosIncidents WorkerSosIncident[]
  workerCustomerRatingsGiven WorkerCustomerRating[] @relation("WorkerGivesRating")
  customerRatingsReceived WorkerCustomerRating[] @relation("CustomerGetsRating")

  // Partners & Notifications
  partners Partner[]
  sentNotifications Notification[] @relation("SentNotifications")

  @@index([role, isDeleted])
  @@index([email])
}

// ==========================================
// 2. WORKER / PARTNER PROFILE
// ==========================================
model WorkerProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills          String[]     @default([])
  serviceCategory String?      // e.g. 'Home Repairs', 'Vehicle Services'
  idProof         String?
  experience      String?      // e.g. 'Fresher', '1-2 Years', '3+ Years'

  workerStatus    WorkerStatus @default(PENDING_INTERVIEW)
  workerAdminNote String?
  isVerified      Boolean      @default(false)

  completedJobs   Int          @default(0)
  shadowJobsDone  Int          @default(0)
  rating          Float        @default(0.0)
  isProBadge      Boolean      @default(false)
  earnings        Float        @default(0.0)

  // QR & Offline Verification
  workerIdCode    String?      @unique
  qrToken         String?      @unique
  qrActive        Boolean      @default(true)
  qrGeneratedAt   DateTime?

  certificates    String[]     @default([])
  languages       String[]     @default(["English", "Hindi"])

  // Geo Location & Availability
  latitude            Float?
  longitude           Float?
  isAvailable         Boolean               @default(true)
  dutyStatus          DutyStatus            @default(OFFLINE)
  dutyStatusUpdatedAt DateTime?             @default(now())
  serviceRadius       Int                   @default(25) // km coverage radius
  lastAssignedAt      DateTime?

  // Services offered by this worker
  services            WorkerService[]
  availabilities      WorkerAvailability[]
  leaves              WorkerLeave[]
  payoutAccount       WorkerPayoutAccount?
  certifications      WorkerCertification[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workerStatus, isVerified, serviceCategory])
  @@index([latitude, longitude])
}

// ==========================================
// 3. SERVICE CATALOG (~110 SERVICES) & VECTOR RAG
// ==========================================
model Service {
  id                String          @id @default(uuid())
  serviceId         String          @unique // e.g. 'ac-repair', 'plumbing-fix'
  name              String
  category          String          // e.g. 'Home Repairs', 'Cleaning & Hygiene'
  subCategory       String?
  description       String?
  basePrice         Float
  estimatedDuration Int             @default(60) // minutes
  isActive          Boolean         @default(true)
  icon              String          @default("🔧")
  image             String          @default("")
  tags              String[]        @default([])
  serviceRadius     Int             @default(20) // km

  // 768-dim embedding array (nomic-embed-text)
  embedding         Float[]         @default([])
  // In-memory / JSON fallback embedding cache
  embeddingJson     String?         @db.Text

  isDeleted         Boolean         @default(false)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Many-to-Many Worker relation
  workers           WorkerService[]
  bookings          Booking[]

  @@index([category, isActive])
  @@index([serviceId])
  @@index([name])
}

// ==========================================
// 4. WORKER-SERVICE JUNCTION (CUSTOM PRICING)
// ==========================================
model WorkerService {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  customPrice     Float?        // Override of basePrice if applicable
  isApproved      Boolean       @default(true)
  isActive        Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([workerProfileId, serviceId])
  @@index([serviceId])
  @@index([workerProfileId])
}

// ==========================================
// 4b. WORKER AVAILABILITY & LEAVE (FEATURE 11 DATA CONTRACT)
// ==========================================
model WorkerAvailability {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  dayOfWeek       Int           // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime       String        // e.g. "09:00"
  endTime         String        // e.g. "18:00"
  isActive        Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([workerProfileId, dayOfWeek])
  @@index([workerProfileId])
}

model WorkerLeave {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  startDate       DateTime
  endDate         DateTime
  reason          String?
  isApproved      Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workerProfileId, startDate, endDate])
}

// ==========================================
// 5. BOOKINGS & SECURE OTP LIFECYCLE
// ==========================================
model Booking {
  id                        String        @id @default(uuid())
  bookingId                 String        @unique // e.g. 'BK-17182939'
  customerId                String
  customer                  User          @relation("CustomerBookings", fields: [customerId], references: [id])

  workerId                  String?
  worker                    User?         @relation("WorkerBookings", fields: [workerId], references: [id])

  traineeId                 String?
  trainee                   User?         @relation("TraineeBookings", fields: [traineeId], references: [id])

  serviceId                 String?
  serviceRef                Service?      @relation(fields: [serviceId], references: [id])
  serviceName               String
  category                  String
  description               String?

  scheduledDate             DateTime
  scheduledTime             String?
  address                   String
  city                      String        @default("Mumbai")

  status                    BookingStatus @default(PENDING)

  // Lifecycle Timestamps & History
  assignedAt                DateTime?
  acceptedAt                DateTime?
  enRouteAt                 DateTime?
  arrivedAt                 DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  cancelledBy               String?

  amount                    Float
  platformCommission        Float         @default(0.0)
  workerEarnings            Float         @default(0.0)
  pricingBreakdown          Json?

  paymentStatus             PaymentStatus @default(PENDING)
  paymentMethod             String?

  // Trust & Safety Worker Verification before OTP
  isWorkerVerifiedBeforeOtp Boolean       @default(false)
  workerVerifiedAt          DateTime?

  // Destination Pin Coordinates (M2 Navigation)
  destinationLat            Float?
  destinationLng            Float?

  // Photo Proof flags (M3)
  hasBeforeProof            Boolean       @default(false)
  hasAfterProof             Boolean       @default(false)

  // COD Collection flags (M5)
  isCodCollected            Boolean       @default(false)
  codCollectedAt            DateTime?
  codAmountCollected        Float?

  // Secure OTP lifecycle
  startOtp                  String?
  endOtp                    String?
  startOtpVerified          Boolean       @default(false)
  endOtpVerified            Boolean       @default(false)
  startOtpExpiresAt         DateTime?
  endOtpExpiresAt           DateTime?
  startOtpAttempts          Int           @default(0)
  endOtpAttempts            Int           @default(0)
  startOtpLocked            Boolean       @default(false)
  endOtpLocked              Boolean       @default(false)

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  transactions              WalletTransaction[]
  reviews                   Review[]
  complaints                Complaint[]
  messages                  BookingMessage[]
  proofs                    BookingProof[]
  quoteRevisions            QuoteRevision[]
  sosIncidents              WorkerSosIncident[]
  workerCustomerRating      WorkerCustomerRating?

  @@index([customerId, status])
  @@index([workerId, status])
  @@index([scheduledDate])
}

// ==========================================
// 6. WALLET TRANSACTIONS & ACID FINANCIAL LOGS
// ==========================================
model WalletTransaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          TransactionType
  amount        Float
  balanceAfter  Float
  description   String
  reference     String?           // bookingId, orderId, refundRef

  bookingId     String?
  booking       Booking?          @relation(fields: [bookingId], references: [id])

  status        TransactionStatus @default(COMPLETED)
  paymentMethod String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([bookingId])
}

// ==========================================
// 7. SUBSCRIPTIONS & B2B CONTRACTS
// ==========================================
model Subscription {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan        SubscriptionPlan   @default(BASIC)
  price       Float              @default(0.0)
  startDate   DateTime           @default(now())
  endDate     DateTime
  status      SubscriptionStatus @default(ACTIVE)
  autoRenew   Boolean            @default(false)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
}

model Contract {
  id           String         @id @default(uuid())
  contractId   String         @unique
  partnerId    String
  partner      User           @relation("PartnerContracts", fields: [partnerId], references: [id], onDelete: Cascade)
  partnerName  String
  contractType ContractType
  services     Json           // [{ name, frequency, pricePerUnit }]
  locations    Json           // [{ name, address, city }]
  totalValue   Float
  startDate    DateTime
  endDate      DateTime
  status       ContractStatus @default(DRAFT)
  autoRenew    Boolean        @default(false)
  notes        String?

  invoices     Invoice[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([partnerId, status])
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceId   String        @unique
  contractId  String?
  contract    Contract?     @relation(fields: [contractId], references: [id])

  partnerId   String
  partner     User          @relation("PartnerInvoices", fields: [partnerId], references: [id])

  items       Json          // [{ description, quantity, unitPrice, total }]
  subtotal    Float
  tax         Float         @default(0.0)
  discount    Float         @default(0.0)
  totalAmount Float
  dueDate     DateTime
  paidDate    DateTime?
  status      InvoiceStatus @default(DRAFT)
  paymentMethod String?
  notes       String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([partnerId, status])
  @@index([contractId])
}

// ==========================================
// 8. REVIEWS, COMPLAINTS, COUPONS
// ==========================================
model Review {
  id         String    @id @default(uuid())
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customerId String
  customer   User      @relation("CustomerReviews", fields: [customerId], references: [id])

  workerId   String
  worker     User      @relation("WorkerReviews", fields: [workerId], references: [id])

  service    String
  rating     Int       // 1 - 5
  comment    String?
  reply      String?
  isEdited   Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([bookingId, customerId])
  @@index([workerId, isDeleted])
}

model Complaint {
  id          String            @id @default(uuid())
  complaintId String            @unique
  bookingId   String?
  booking     Booking?          @relation(fields: [bookingId], references: [id])

  filedById   String
  filedBy     User              @relation("FiledComplaints", fields: [filedById], references: [id])

  againstUserId String?
  againstUser User?             @relation("AgainstUserComplaints", fields: [againstUserId], references: [id])

  subject     String
  description String
  category    ComplaintCategory @default(OTHER)
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)

  resolution  String?
  resolvedById String?
  resolvedBy  User?             @relation("ResolvedByAdminComplaints", fields: [resolvedById], references: [id])
  resolvedAt  DateTime?
  attachments String[]          @default([])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([filedById, status])
  @@index([againstUserId])
}

model Coupon {
  id                   String           @id @default(uuid())
  code                 String           @unique
  description          String?
  discountType         DiscountType     @default(PERCENTAGE)
  discountValue        Float
  minOrderAmount       Float            @default(0.0)
  maxDiscount          Float?
  usageLimit           Int              @default(100)
  usedCount            Int              @default(0)
  validFrom            DateTime         @default(now())
  validUntil           DateTime
  applicableCategories String[]         @default([])
  applicablePlans      SubscriptionPlan[] @default([])
  isActive             Boolean          @default(true)

  createdById          String?
  createdBy            User?            @relation("AdminCoupons", fields: [createdById], references: [id])

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([code, isActive])
}

// ==========================================
// 9. WORKER OPERATIONS EXTENSIONS (MILESTONES M2–M6)
// ==========================================

// M2: Booking-scoped chat & messages
model BookingMessage {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  text      String
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// M3: Before / After Work Photos
model BookingProof {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId  String
  worker    User      @relation(fields: [workerId], references: [id])

  type      ProofType
  imageUrl  String
  notes     String?

  createdAt DateTime  @default(now())

  @@index([bookingId, type])
}

// M4: Quote Revisions (Spare parts / extra materials)
model QuoteRevision {
  id           String         @id @default(uuid())
  bookingId    String
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedBy  String         // worker user id
  items        Json           // array of { name, quantity, unitPrice, amount }
  totalAmount  Float
  status       RevisionStatus @default(PENDING)
  notes        String?
  customerNote String?
  decidedAt    DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([bookingId, status])
}

// M4: Worker Payout Account Destination (Masked / Protected)
model WorkerPayoutAccount {
  id              String        @id @default(uuid())
  workerProfileId String        @unique
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  type            PayoutType    @default(UPI)
  accountNumber   String?       // encrypted / masked (e.g. "******1234")
  ifscCode        String?
  upiId           String?       // e.g. "worker@upi"
  accountHolder   String?
  isVerified      Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// M5: Payout Withdrawal Requests & Ledger
model PayoutRequest {
  id          String        @id @default(uuid())
  workerId    String
  worker      User          @relation(fields: [workerId], references: [id])

  amount      Float
  fee         Float         @default(0.0)
  netAmount   Float
  payoutType  PayoutType
  destination String        // Masked VPA or bank destination
  status      PayoutStatus  @default(PENDING)
  utr         String?
  notes       String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workerId, status])
}

// M6: Emergency Worker SOS Incidents
model WorkerSosIncident {
  id         String      @id @default(uuid())
  workerId   String
  worker     User        @relation(fields: [workerId], references: [id])

  bookingId  String?
  booking    Booking?    @relation(fields: [bookingId], references: [id])

  latitude   Float?
  longitude  Float?
  severity   SosSeverity @default(HIGH)
  status     SosStatus   @default(ACTIVE)
  adminNote  String?
  resolvedAt DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
}

// M6: Worker Skill Certifications
model WorkerCertification {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  moduleName      String
  score           Int           @default(100)
  certificateCode String        @unique
  issuedAt        DateTime      @default(now())

  @@index([workerProfileId])
}

// M6: Worker-to-Customer Reviews (Two-way Rating)
model WorkerCustomerRating {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId   String
  worker     User     @relation("WorkerGivesRating", fields: [workerId], references: [id])

  customerId String
  customer   User     @relation("CustomerGetsRating", fields: [customerId], references: [id])

  rating     Int      // 1 to 5
  tags       String[] @default([])
  comment    String?

  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([workerId])
}

// ==========================================
// 10. PARTNERS, NOTIFICATIONS & SYSTEM LOGS (POSTGRES UNIFICATION)
// ==========================================

enum PartnerType {
  NGO
  GOVERNMENT
  CORPORATE
  SOCIETY
  OTHER
}

enum PartnershipType {
  TRAINING
  EMPLOYMENT
  SERVICE_PROVIDER
  BULK_CLIENT
  SOCIAL_IMPACT
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Partner {
  id              String          @id @default(uuid())
  name            String
  type            PartnerType     @default(OTHER)
  contactPerson   String
  email           String
  phone           String?
  description     String?
  website         String?
  address         String?
  city            String?
  partnershipType PartnershipType @default(SERVICE_PROVIDER)
  status          PartnerStatus   @default(PENDING)
  startDate       DateTime?
  logo            String?
  linkedUserId    String?
  linkedUser      User?           @relation(fields: [linkedUserId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, type])
}

enum NotificationType {
  BROADCAST
  PERSONAL
  BOOKING_UPDATE
  PROMOTION
  ALERT
  SYSTEM
}

enum NotificationAudience {
  ALL
  CUSTOMERS
  WORKERS
  B2B
  SPECIFIC
}

model Notification {
  id             String               @id @default(uuid())
  title          String
  message        String
  type           NotificationType     @default(PERSONAL)
  targetAudience NotificationAudience @default(ALL)
  targetUsers    String[]             @default([]) // user IDs
  readBy         String[]             @default([]) // user IDs
  sentById       String?
  sentBy         User?                @relation("SentNotifications", fields: [sentById], references: [id])
  isActive       Boolean              @default(true)
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([targetAudience, isActive])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  role       String?
  action     String
  module     String?
  targetId   String?
  targetRef  String?
  duration   Int?
  device     String?
  platform   String?
  browser    String?
  userAgent  String?
  country    String?
  city       String?
  requestId  String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action, module])
}

model EventLog {
  id            String   @id @default(uuid())
  eventId       String   @unique
  eventType     String
  entityType    String
  entityId      String?
  actorId       String?
  actorRole     String?
  bookingId     String?
  serviceId     String?
  customerId    String?
  workerId      String?
  timestamp     DateTime @default(now())
  previousState String?
  currentState  String?
  metadata      Json?    @default("{}")
  requestId     String?
  ipAddress     String?
  userAgent     String?

  @@index([eventType, entityType])
  @@index([bookingId])
  @@index([timestamp])
}

model AIAnalysis {
  id          String   @id @default(uuid())
  analysisId  String   @unique
  requestId   String?
  provider    String   @default("gemini")
  model       String   @default("gemini-2.0-flash")
  feature     String
  bookingId   String?
  customerId  String?
  workerId    String?
  language    String   @default("English")
  imageHash   String?
  rawResponse Json?
  result      Json?
  createdAt   DateTime @default(now())

  @@index([analysisId])
  @@index([feature, createdAt])
}

model DocumentHistory {
  id            String   @id @default(uuid())
  collection    String
  documentId    String
  version       Int
  changedFields String[] @default([])
  oldValues     Json?    @default("{}")
  newValues     Json?    @default("{}")
  snapshot      Json?    @default("{}")
  changedById   String?
  changedByRole String?
  changeReason  String?
  timestamp     DateTime @default(now())

  @@index([collection, documentId])
}

model AnalyticsRecord {
  id         String   @id @default(uuid())
  metricType String   // 'CUSTOMER_METRIC', 'WORKER_METRIC', 'TRUST_PROFILE', 'DEMAND_HISTORY', etc.
  entityId   String?
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([metricType, entityId])
}
